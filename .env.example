# Copy this file to .env and fill in real values before running docker compose.
# Never commit .env with real secrets to version control.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=tryoutapp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_to_a_strong_password

# DB connection (backend reads these; must match Postgres values above).
# Under Compose the backend reaches Postgres by service name (`db`), which
# docker-compose.yml sets directly — DB_HOST here is for standalone runs.
DB_HOST=db
DB_PORT=5432
DB_NAME=tryoutapp
DB_USER=postgres
DB_PASS=change_me_to_a_strong_password

# ── Backend ───────────────────────────────────────────────────────────────────
# JWT_SECRET: minimum 32 random characters. Use `openssl rand -hex 32` to generate.
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars

NODE_ENV=development

# ── Frontend ──────────────────────────────────────────────────────────────────
# Interpolated by docker-compose.yml; the container also gets VITE_API_TARGET
# so the Vite dev-server proxy can reach the backend over the Compose network.
VITE_API_URL=http://localhost:4000

# ── CORS (production only) ────────────────────────────────────────────────────
# Comma-separated allowed origins. Required when NODE_ENV=production.
# CORS_ORIGINS=https://your-domain.com

# ── Pool sizing (optional) ────────────────────────────────────────────────────
# DB_POOL_MAX=10
# DB_POOL_IDLE_MS=30000

# ── Mail (local dev uses Mailhog — no changes needed) ────────────────────────
MAIL_HOST=mailhog
MAIL_PORT=1025
